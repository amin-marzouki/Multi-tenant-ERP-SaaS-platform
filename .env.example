# Copy to .env next to docker-compose.prod.yml. Never commit the real .env.
# In CI these come from GitHub Actions secrets; the deploy job writes .env on the VPS.

# Owner of the ghcr.io images (lowercase GitHub user or org) and the tag to run
IMAGE_OWNER=amin-marzouki
IMAGE_TAG=latest

MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# At least 32 characters, random. For example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more

# Optional: with orbiterp.app, acme.orbiterp.app is the "acme" workspace. Leave empty to disable.
BASE_DOMAIN=
