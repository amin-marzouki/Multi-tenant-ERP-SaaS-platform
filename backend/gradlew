#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLE_VERSION="8.9"
GRADLE_HOME="$ROOT_DIR/.gradle"
GRADLE_DIST="$GRADLE_HOME/gradle-$GRADLE_VERSION"
ARCHIVE="$GRADLE_HOME/gradle-$GRADLE_VERSION-bin.zip"

mkdir -p "$GRADLE_HOME"

if [ ! -x "$GRADLE_DIST/bin/gradle" ]; then
  if [ ! -f "$ARCHIVE" ]; then
    echo "Downloading Gradle $GRADLE_VERSION..."
    curl -L "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ARCHIVE"
  fi

  rm -rf "$GRADLE_DIST"
  unzip -q "$ARCHIVE" -d "$GRADLE_HOME"
fi

exec "$GRADLE_DIST/bin/gradle" "$@"
