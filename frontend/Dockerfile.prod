# Build the Angular app (production configuration)
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Serve the build with nginx, which also proxies /api to the backend
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/orbiterp-frontend /usr/share/nginx/html
EXPOSE 80
